# Device backend: mobilerun (cloud API, default) or adb (a local/USB device via Android platform-tools).
JEV_DEVICE_BACKEND=mobilerun

# Create a key at https://cloud.mobilerun.ai/api-keys
MOBILERUN_API_KEY=

# Run `pnpm devices` to find the ID of your own ready Android device.
MOBILERUN_DEVICE_ID=
MOBILERUN_BASE_URL=https://api.mobilerun.ai/v1
# Faster input acknowledgements, with exact local read-back before the next action.
# Set committed to retain the server-side completion wait for all text input.
MOBILERUN_TEXT_COMPLETION_MODE=accepted

# ADB backend only. ADB_SERIAL may stay empty when exactly one device is connected (`adb devices`).
ADB_SERIAL=
ADB_PATH=adb
# Optional JSON labels for app matching, e.g. {"com.tencent.mm":"WeChat"}. Defaults derive from package names.
ADB_APP_LABELS=

# Optional fixed-control profile for games without a UI tree, e.g. layouts/genshin-impact.json.
JEV_LAYOUT=
# Local OCR of the profile's text regions (needs the optional OCR packages). Set to off to disable.
JEV_OCR=

# Create a TypeSafe key at https://console.typesafe.ai
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Optional TypeSafe-compatible gateway. For OpenRouter set https://openrouter.ai/api and put an
# OpenRouter API key in TYPESAFE_API_KEY; billing then goes to the OpenRouter account.
TYPESAFE_BASE_URL=

# The studio binds to localhost only. Change this if the port is already in use.
STUDIO_PORT=3040
